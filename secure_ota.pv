(* ================================================================
   Secure Stateless UDP Broadcast OTA - ProVerif Model

   ATTACKS MODELED:
     1. Forged recovery request
     2. Request flooding
     3. Firmware injection
     4. Downgrade
     5. Replay of valid recovery request
     6. Firmware/chunk tampering

   IMPORTANT:
   - Flooding is modeled as an unbounded number of attacker-generated
     recovery messages. ProVerif verifies that forged messages cannot
     become authenticated recovery requests. It does not measure CPU,
     bandwidth, or resource exhaustion.
   - Replay is explicitly tested using injective correspondence.
     The current protocol is expected to permit replay of a previously
     valid signed recovery request.
   ================================================================ *)

free c: channel.

(* ================================================================
   TYPES
   ================================================================ *)

type host.
type key.
type version.
type firmware.
type hashvalue.
type signature.

free Admin: host.
free Device: host.

(* ================================================================
   CRYPTOGRAPHIC PRIMITIVES
   ================================================================ *)

fun pk(key): key.

fun sign(bitstring, key): signature.

reduc forall m: bitstring, sk: key;
      verify(sign(m, sk), pk(sk)) = m.

fun hash(firmware): hashvalue.

(* ================================================================
   VERSION MODEL
   ================================================================ *)

const current_version: version.
const newer_version: version.

(* ================================================================
   SECURITY EVENTS
   ================================================================ *)

(* Legitimate firmware generated by administrator. *)
event adminSendsFirmware(firmware).

(* Firmware accepted by device. *)
event deviceAcceptsFirmware(firmware).

(* Firmware passed authenticated hash verification. *)
event deviceAcceptsIntegrityVerifiedFirmware(firmware).

(* Firmware passed version/freshness verification. *)
event deviceAcceptsNewerVersion(version).

(* Legitimate device generates a particular recovery request. *)
event deviceSendsRecovery(host, bitstring).

(* Administrator accepts/processes a particular recovery request. *)
event adminProcessesRecovery(host, bitstring).

(* ================================================================
   SECURITY QUERIES
   ================================================================ *)

(* ------------------------------------------------
   1. FIRMWARE INJECTION
   Firmware accepted by the device must originate from
   the legitimate administrator.
   ------------------------------------------------ *)

query fw: firmware;
      event(deviceAcceptsFirmware(fw))
      ==> event(adminSendsFirmware(fw)).


(* ------------------------------------------------
   2. FORGED RECOVERY REQUEST
   Every authenticated recovery request processed by the
   administrator must have been generated by the legitimate
   device.

   This query is also evaluated while the public channel
   permits an attacker to inject arbitrary requests.
   ------------------------------------------------ *)

query h: host, msg: bitstring;
      event(adminProcessesRecovery(h, msg))
      ==> event(deviceSendsRecovery(h, msg)).


(* ------------------------------------------------
   3. FIRMWARE / CHUNK TAMPERING
   Accepted firmware must have passed verification against
   the hash contained in authenticated firmware metadata.
   ------------------------------------------------ *)

query fw: firmware;
      event(deviceAcceptsFirmware(fw))
      ==> event(deviceAcceptsIntegrityVerifiedFirmware(fw)).


(* ------------------------------------------------
   4. DOWNGRADE
   Firmware reaching the accepted-version state must have
   the modeled newer version.
   ------------------------------------------------ *)

query v: version;
      event(deviceAcceptsNewerVersion(v))
      ==> v = newer_version.


(* ------------------------------------------------
   5. REPLAY OF VALID RECOVERY REQUEST
   Injective correspondence tests whether every accepted
   recovery request corresponds to a DISTINCT legitimate
   transmission by the device.

   With the current protocol, this query is EXPECTED TO FAIL
   because a captured valid signed request can be replayed.
   ------------------------------------------------ *)

query h: host, msg: bitstring;
      inj-event(adminProcessesRecovery(h, msg))
      ==> inj-event(deviceSendsRecovery(h, msg)).


(* ================================================================
   RECOVERY REQUEST HANDLER
   ================================================================ *)

let recovery_handler(pkD: key) =

    (* The replicated handler in admin() below allows an
       unbounded number of requests.

       Therefore the attacker may inject/flood/replay
       arbitrarily many recovery messages. *)

    in(c, (lostMsg: bitstring,
           devSig: signature));

    let verified_lost = verify(devSig, pkD) in

    if lostMsg = verified_lost then

        let (sender_identity: host,
             chunk_list: bitstring) = lostMsg in

        event adminProcessesRecovery(
            sender_identity,
            lostMsg
        ).


(* ================================================================
   ADMINISTRATOR PROCESS
   ================================================================ *)

let admin(skA: key, pkD: key) =

    new fw: firmware;

    (* Construct authenticated firmware metadata. *)

    let header_payload =
        (newer_version, hash(fw)) in

    let sigA =
        sign(header_payload, skA) in

    event adminSendsFirmware(fw);

    (* Broadcast authenticated metadata. *)
    out(c, (header_payload, sigA));

    (* Abstract representation of firmware/chunk distribution. *)
    out(c, fw);

    (* ------------------------------------------------------------
       FLOODING + REPLAY MODEL

       Replication means the administrator can receive an
       unbounded number of recovery requests.

       The attacker controls public channel c and can therefore:
         - inject forged requests,
         - send arbitrarily many requests,
         - replay captured valid requests.

       Only requests with valid device signatures can reach
       adminProcessesRecovery().
       ------------------------------------------------------------ *)

    !recovery_handler(pkD).


(* ================================================================
   DEVICE PROCESS
   ================================================================ *)

let device(pkA: key, skD: key) =

    (* Receive firmware metadata. *)

    in(c, (header_bytes: bitstring,
           sigA: signature));

    (* Verify administrator signature. *)

    let verified_header =
        verify(sigA, pkA) in

    if header_bytes = verified_header then

        let (ver: version,
             expected_hash: hashvalue) =
             header_bytes in

        (* --------------------------------------------------------
           DOWNGRADE / FRESHNESS PROTECTION
           -------------------------------------------------------- *)

        if ver = newer_version then

            in(c, fw_received: firmware);

            (* ----------------------------------------------------
               TAMPERING / INTEGRITY PROTECTION

               Modified firmware cannot be accepted unless its
               hash matches the value authenticated in the
               administrator-signed metadata.
               ---------------------------------------------------- *)

            if hash(fw_received) = expected_hash then
            (
                event deviceAcceptsNewerVersion(ver);

                event deviceAcceptsIntegrityVerifiedFirmware(
                    fw_received
                );

                event deviceAcceptsFirmware(
                    fw_received
                );

                (* ------------------------------------------------
                   CREATE LEGITIMATE RECOVERY REQUEST
                   ------------------------------------------------ *)

                new missing_chunks: bitstring;

                let recovery_payload =
                    (Device, missing_chunks) in

                event deviceSendsRecovery(
                    Device,
                    recovery_payload
                );

                let dev_sig =
                    sign(recovery_payload, skD) in

                (* Public transmission means attacker may capture
                   this exact signed request and replay it. *)

                out(c, (recovery_payload, dev_sig))
            )

            else 0

        else 0

    else 0.


(* ================================================================
   MAIN SYSTEM
   ================================================================ *)

process

    new skA: key;
    new skD: key;

    let pkA = pk(skA) in
    let pkD = pk(skD) in

    (* Public keys are intentionally public.
       Private keys remain secret. *)

    out(c, (pkA, pkD));

    (
        admin(skA, pkD)
        |
        device(pkA, skD)
    )
